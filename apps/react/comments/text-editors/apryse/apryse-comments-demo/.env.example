# Copy this file to .env.local and fill in the values.
# On Vercel, add these as Environment Variables in Project Settings.

# [Velt] Public API key — exposed to the browser (NEXT_PUBLIC_ prefix).
# Get it from https://console.velt.dev
NEXT_PUBLIC_VELT_API_KEY=

# [Velt] Auth token — SERVER-ONLY secret, never exposed to the browser.
# Used by /api/velt/token to generate JWT tokens. Get it from https://console.velt.dev
VELT_AUTH_TOKEN=

# [Apryse] WebViewer license key — exposed to the browser (NEXT_PUBLIC_ prefix).
# Optional: without it the viewer runs in demo mode with a watermark.
NEXT_PUBLIC_APRYSE_LICENSE_KEY=
