# Privado Demo Frontend - Environment Variables
# Copy this file to .env.local and fill in your values

# Velt API Key (required)
# Get this from https://console.velt.dev
NEXT_PUBLIC_VELT_API_KEY=your_velt_api_key_here

# Self-Hosting Backend URL (required for self-hosting)
# Points to the Django backend API
# Development: http://localhost:8000/api/velt
# Production: https://your-backend-domain.com/api/velt
NEXT_PUBLIC_SELF_HOSTING_BASE_URL=http://localhost:8000/api/velt

# Velt Auth Token (used by the /api/velt/token endpoint)
# Get this from https://console.velt.dev
VELT_AUTH_TOKEN=your_velt_auth_token_here
