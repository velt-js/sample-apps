{
  "mcpServers": {
    "velt-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@veltdev/mcp-server"
      ],
      "env": {
        "VELT_API_KEY": "${VELT_API_KEY}",
        "VELT_AUTH_TOKEN": "${VELT_AUTH_TOKEN}"
      },
      "description": "Velt MCP server for documentation, integration examples, and best practices"
    },
    "add-velt-cli": {
      "command": "node",
      "args": [
        "${ADD_VELT_CLI_PATH}/bin/velt.js"
      ],
      "description": "Official Velt CLI for Next.js installation"
    }
  },
  "agents": {
    "velt-coordinator": {
      "name": "Velt Installation Coordinator",
      "description": "Orchestrates complete Velt installation with discovery, customization, and validation",
      "agentFile": ".claude/agents/coordinator.md",
      "triggers": [
        "install velt",
        "setup velt",
        "add velt to project"
      ]
    },
    "velt-discovery": {
      "name": "Velt Discovery Agent",
      "description": "Analyzes codebase to detect frameworks, libraries, and project structure",
      "agentFile": ".claude/agents/discovery.md",
      "triggers": [
        "discover codebase",
        "analyze project structure",
        "detect libraries"
      ]
    },
    "velt-customization": {
      "name": "Velt Customization Agent",
      "description": "Orchestrates customization of Velt integration based on project specifics",
      "agentFile": ".claude/agents/customization.md",
      "triggers": [
        "customize velt",
        "adapt velt integration"
      ]
    },
    "velt-auth-adapter": {
      "name": "Velt Auth Adapter",
      "description": "Ensures proper VeltProvider placement and authentication setup",
      "agentFile": ".claude/agents/auth-adapter.md",
      "triggers": [
        "setup velt auth",
        "configure velt provider"
      ]
    },
    "velt-comments-adapter": {
      "name": "Velt Comments Adapter",
      "description": "Implements library-specific comment targeting and customization",
      "agentFile": ".claude/agents/comments-adapter.md",
      "triggers": [
        "setup velt comments",
        "add comments to",
        "integrate comments with"
      ]
    },
    "velt-cleanup": {
      "name": "Velt Cleanup Agent",
      "description": "Removes unselected Velt features and cleans up unused code",
      "agentFile": ".claude/agents/cleanup.md",
      "triggers": [
        "cleanup velt",
        "remove unused velt features"
      ]
    },
    "velt-validation": {
      "name": "Velt Validation Agent",
      "description": "Performs comprehensive QA checks on Velt installation",
      "agentFile": ".claude/agents/validation.md",
      "triggers": [
        "validate velt",
        "check velt installation",
        "verify velt setup"
      ]
    },
    "velt-mcp-helper": {
      "name": "Velt MCP Helper",
      "description": "Queries Velt MCP for integration examples and best practices",
      "agentFile": ".claude/agents/mcp-helper.md",
      "triggers": [
        "get velt examples",
        "velt integration guide",
        "velt best practices"
      ]
    }
  },
  "settings": {
    "velt": {
      "autoLoadAgents": true,
      "enableMCP": true,
      "defaultFeatures": [
        "comments",
        "presence"
      ],
      "supportedLibraries": [
        "ag-grid-react",
        "@tanstack/react-table",
        "@tiptap/react",
        "lexical",
        "slate",
        "codemirror",
        "reactflow",
        "@excalidraw/excalidraw"
      ],
      "supportedAuthProviders": [
        "next-auth",
        "@clerk/nextjs",
        "@supabase/auth-helpers-react",
        "@auth0/nextjs-auth0"
      ]
    }
  },
  "metadata": {
    "version": "1.0.0",
    "lastUpdated": "2024-01-01T00:00:00Z",
    "documentation": "https://docs.velt.dev",
    "support": "support@velt.dev"
  }
}
